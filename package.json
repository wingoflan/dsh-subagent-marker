{
  "name": "dsh-subagent-marker",
  "version": "0.1.0",
  "description": "Marks the composer of a subagent session in DeepSeek Harness, so you can tell at a glance whether you are talking to a subagent.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "subagent",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingoflan/dsh-subagent-marker.git"
  },
  "bugs": {
    "url": "https://github.com/wingoflan/dsh-subagent-marker/issues"
  },
  "homepage": "https://github.com/wingoflan/dsh-subagent-marker#readme",
  "dsh": {
    "displayName": "Subagent Marker",
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  }
}
